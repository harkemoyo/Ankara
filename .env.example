# =============================================
# Mary Humphrey Wear — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# =============================================

# --- Supabase (Database & Storage) ---
# From: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Paystack (Card & Multi-Currency Payment) ---
# From: Paystack Dashboard -> Settings -> API Keys & Webhooks
# Set Webhook URL in Paystack to: https://yourdomain.com/api/payments/paystack/webhook
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_if_separate

# --- Meta WhatsApp Cloud API (Automated Server Notifications) ---
# From: Meta for Developers -> WhatsApp -> API Setup & Configuration
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MARY_PHONE=254700000000

# Meta Approved Template Names (created in Meta Business Manager):
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMATION=mhw_payment_confirmed
WHATSAPP_TEMPLATE_MARY_ALERT=mhw_payment_alert_mary
WHATSAPP_TEMPLATE_STATUS_UPDATE=mhw_order_status_update
WHATSAPP_TEMPLATE_NEW_ORDER_MARY=mhw_new_order_mary

# --- MailerSend (Transactional Receipts) ---
# From: MailerSend Dashboard -> Domains & API Tokens
MAILERSEND_API_KEY=mlsn.your_mailersend_api_key
MAILERSEND_SENDER_EMAIL=info@send.yourdomain.com
MAILERSEND_SENDER_NAME="Mary Humphrey African Wear"

# --- Business Owner Alerts ---
# Where new-order and made-to-measure owner alerts are sent
# while WhatsApp is unavailable
OWNER_EMAIL=info@maryhumphreywear.org

# --- Admin Operations ---
# Used for server-to-server admin calls (e.g. updating order status)
ADMIN_SECRET=your_random_admin_secret_key

# --- Server & SMTP Fallback ---
PORT=3000
HOST=localhost
NODE_ENV=development
BASE_URL=https://yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_SENDER_NAME="Mary Humphrey African Wear"
