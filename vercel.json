{
  "version": 2,
  "builds": [
    {
      "src": "assets/api/handler.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/assets/api/handler.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/assets/api/handler.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(ico|png|jpg))",
      "dest": "/$1"
    },
    {
      "src": "/shop/([^/]+)",
      "dest": "/shop.html"
    },
    {
      "src": "/product/([^/]+)",
      "dest": "/product.html"
    },
    {
      "src": "/products/([^/]+)",
      "dest": "/product.html"
    },
    {
      "src": "/(menswear|womenswear|unisex|new-arrivals|nova|nova-collection)",
      "dest": "/shop.html?collection=$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/fabric",
      "dest": "/material.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/sale",
      "dest": "/sale.html"
    },
    {
      "src": "/shop",
      "dest": "/shop.html"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "src": "/account",
      "dest": "/account.html"
    },
    {
      "src": "/order-status",
      "dest": "/order-status.html"
    },
    {
      "src": "/(legal/)?(privacy|privacy-policy)(\\.html)?",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "/(legal/)?(terms|terms-of-service|terms-and-conditions)(\\.html)?",
      "dest": "/terms-of-service.html"
    },
    {
      "src": "/(legal/)?(shipping|shipping-policy)(\\.html)?",
      "dest": "/shipping-policy.html"
    },
    {
      "src": "/(legal/)?(refund|refunds|refund-policy|returns)(\\.html)?",
      "dest": "/refund-policy.html"
    },
    {
      "src": "/thank-you",
      "dest": "/thank-you.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}